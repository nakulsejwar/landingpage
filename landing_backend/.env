# ── LLM (OpenRouter replaces Gemini) ─────────────────────────────────────────
# Get your key from https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_key_here

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase: use the "Transaction pooler" URL from your Supabase project dashboard
# Project Settings → Database → Connection string → Transaction pooler
# It looks like: postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
#
# IMPORTANT: add ?sslmode=require at the end
DATABASE_URL=postgresql://postgres:qiz3xBAOZ4bd1bC5@db.cdqyxpdxbnuehopnotnk.supabase.co:5432/postgres?sslmode=require

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-cbod$($+0w(*i9^$v#2-a#7u8o5^((@*o+xrrpy^84!4$xjr2p
DEBUG=True

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Email (for contact form notifications) ────────────────────────────────────
# Gmail: use an App Password (not your normal password)
# https://support.google.com/accounts/answer/185833
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=your_email@gmail.com
